#!/usr/bin/env bash
# Block commits that contain secrets. See PUBLISHING.md.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed: brew install gitleaks" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner

# README tool tables must match the Brewfile
if git diff --cached --name-only | grep -qE '^(Brewfile|README\.md)$'; then
  "$(git rev-parse --show-toplevel)/scripts/gen-tools.py" --check
fi
